[global]
    monitor = 0
    follow = mouse
    width = 320
    height = 300
    origin = top-right
    offset = 20x48
    scale = 0
    notification_limit = 6
    stack_duplicates = false
    hide_duplicate_count = true

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4
    highlight = "#E6E9EF"

    indicate_hidden = yes
    transparency = 0
    separator_height = 8
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    gap_size = 8

    corner_radius = 8

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    min_icon_size = 24
    max_icon_size = 40

    background = "#1A1D23"
    foreground = "#C5C8CE"
    frame_color = "#3A404C"
    separator_color = frame

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1A1D23"
    foreground = "#C5C8CE"
    frame_color = "#3A404C"
    timeout = 4

[urgency_normal]
    background = "#1A1D23"
    foreground = "#E6E9EF"
    frame_color = "#3A404C"
    timeout = 6

[urgency_critical]
    background = "#1A1D23"
    foreground = "#FF5F87"
    frame_color = "#FF5F87"
    timeout = 0
